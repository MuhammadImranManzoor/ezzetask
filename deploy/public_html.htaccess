# Copy to public_html/.htaccess (same folder as index.html)

RewriteEngine On

# /api/* is served from public_html/api/ (see api/.htaccess — existing files like seed.php stay reachable)

# SPA: serve index.html for non-file routes (optional; app has no client routes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
