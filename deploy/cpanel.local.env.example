# Copy to deploy/cpanel.local.env (gitignored) and fill in your cPanel SSH or FTP details.

# ssh (recommended if cPanel → SSH Access is enabled)
DEPLOY_METHOD=ssh
DEPLOY_SSH_HOST=yourdomain.com
DEPLOY_SSH_USER=your_cpanel_username
DEPLOY_SSH_PORT=22
# Path from your home directory on the server (usually public_html)
DEPLOY_REMOTE_PUBLIC=public_html

# ftp (if you do not have SSH — install lftp: brew install lftp)
# DEPLOY_METHOD=ftp
# DEPLOY_FTP_HOST=yourdomain.com
# (If ftp.yourdomain.com fails DNS, use yourdomain.com or the server IP from cPanel.)
# DEPLOY_FTP_USER=your_cpanel_username
# DEPLOY_FTP_PASS=your_ftp_password
# DEPLOY_REMOTE_PUBLIC=public_html
